  "topic": "C++",
  "chapters": [
    {
      "order": 1,
      "title": "Introduction to C++",
      "points": [
        "What is C++?",
        "History of C++",
        "Setting up environment"
      ]
    },
    {
      "order": 2,
      "title": "Variables & Data Types",
      "points": [
        "Primitive types",
        "Type casting"
      ]
    }
  ],
  "resources": [
    {
      "title": "C++ Full Course — freeCodeCamp",
      "url": "https://youtube.com/watch?v=xxx",
      "type": "youtube"
    },
    {
